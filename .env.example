# ШАБЛОН ФАЙЛА НАСТРОЕК
# 1. Скопируйте этот файл в .env:  cp .env.example .env
# 2. Заполните значения своими ключами.
# 3. Файл .env добавлен в .gitignore и НЕ должен попадать в Git-репозиторий!

# --- Telegram ---
# Токен бота выдаёт @BotFather в Telegram
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- База данных ---
# PostgreSQL (основной вариант по техническому заданию):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gamehunter
# Для быстрого запуска без PostgreSQL можно использовать SQLite (только для разработки):
# DATABASE_URL=sqlite:///gamehunter.db

# --- Внешние API ---
# RAWG Video Games Database — каталог видеоигр: https://rawg.io/apidocs
# Ключ выдаётся бесплатно после регистрации (профиль -> API Key)
RAWG_API_KEY=

# Прокси для всех внешних запросов (Telegram API, RAWG, геолокация).
# Нужен, если api.telegram.org недоступен напрямую (без VPN бот не запустится).
# Примеры: socks5://127.0.0.1:1080  или  http://127.0.0.1:8080
# Для socks5 дополнительно установите PySocks: pip install pysocks
# PROXY_URL=

# Сервис геолокации по IP-адресу (ключ не требуется).
# По умолчанию используется ipapi.co; при необходимости можно заменить,
# например на https://ipwho.is
IP_LOCATION_BASE_URL=https://ipapi.co

# --- Необязательные настройки (можно не менять) ---
# Язык каталога игр (ru — описания и названия на русском, где они есть)
CATALOG_LANGUAGE=ru
# Сколько игр показывать на одной странице подборки
MAX_GAMES=5
# Сколько жанров (интересов) предлагать на выбор
MAX_GENRES=12
# Сколько франшиз показывать в результатах поиска
MAX_FRANCHISES=5
# Сколько дополнительных карточек игр догружать для проверки возрастного рейтинга
DETAILS_FETCH_LIMIT=8
# Сколько записей на странице «Во что я играл» и «Избранное»
LIBRARY_PAGE_SIZE=5
# Максимальная длина отзыва об игре, символов
REVIEW_MAX_LENGTH=1000
# Сортировка подборки: -rating (по рейтингу), -released (по дате выхода)
DEFAULT_ORDERING=-rating
# Таймаут HTTP-запросов к внешним API, секунд
HTTP_TIMEOUT=10
# Время жизни кэша справочников (жанры, платформы, карточки игр), секунд
CACHE_TTL_SECONDS=600
# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
