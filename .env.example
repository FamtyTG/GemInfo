# ШАБЛОН ФАЙЛА НАСТРОЕК
# 1. Скопируйте этот файл в .env:  cp .env.example .env
# 2. Заполните значения своими ключами.
# 3. Файл .env добавлен в .gitignore и НЕ должен попадать в Git-репозиторий!

# --- Telegram ---
# Токен бота выдаёт @BotFather в Telegram
BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- База данных ---
# PostgreSQL (основной вариант по техническому заданию):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/travelhunter
# Для быстрого запуска без PostgreSQL можно использовать SQLite (только для разработки):
# DATABASE_URL=sqlite:///travelhunter.db

# --- Внешние API ---
# Ninjas API (праздники): https://api-ninjas.com/  -> ключ в личном кабинете
NINJAS_API_KEY=

# GeoNames (поиск городов и ближайших населённых пунктов): https://www.geonames.org/login
# После регистрации нужно включить доступ к бесплатным веб-сервисам:
# https://www.geonames.org/manageaccount -> "Enable" для Free Web Services
GEONAMES_USERNAME=

# Необязательно: предпочтение стране при поиске города (например, RU).
# Это «мягкая» настройка: города других стран всё равно находятся.
GEONAMES_COUNTRY_BIAS=

# --- Необязательные настройки (можно не менять) ---
# Язык Википедии
WIKIPEDIA_LANGUAGE=ru
# Радиус поиска ближайших городов, км
NEARBY_RADIUS_KM=500
# Сколько праздников показывать пользователю
MAX_HOLIDAYS=5
# Сколько ближайших городов показывать пользователю
MAX_NEARBY_CITIES=5
# Сколько поездок на одной странице истории
HISTORY_PAGE_SIZE=5
# Максимальная длина заметки, символов
NOTE_MAX_LENGTH=1000
# Таймаут HTTP-запросов к внешним API, секунд
HTTP_TIMEOUT=10
# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
